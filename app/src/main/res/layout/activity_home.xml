<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="0dp"
        android:layout_height="@dimen/vs_80"
        android:layout_marginTop="@dimen/vs_5"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/vs_30"
        android:paddingRight="@dimen/vs_30"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/logoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_sort_pill"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/vs_10"
            android:paddingTop="@dimen/vs_5"
            android:paddingRight="@dimen/vs_15"
            android:paddingBottom="@dimen/vs_5">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="@dimen/vs_50"
                android:layout_height="@dimen/vs_50"
                android:focusable="false"
                android:src="@drawable/app_icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:layout_marginLeft="@dimen/vs_10"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLogoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:focusable="false"
                    android:text="TVBOX"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/ts_26"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:focusable="false"
                    android:singleLine="true"
                    android:text="@string/app_name"
                    android:textColor="@color/newui_text_secondary"
                    android:textSize="@dimen/ts_14" />
            </LinearLayout>
        </LinearLayout>

        <com.owen.tvrecyclerview.widget.TvRecyclerView
            android:id="@+id/mGridView"
            android:layout_width="0dp"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_10"
            android:layout_weight="1"
            android:clipToPadding="false"
            app:tv_selectedItemIsCentered="true" />

        <LinearLayout
            android:id="@+id/btnSearch"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_15"
            android:background="@drawable/shape_user_focus"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/vs_30"
                android:layout_height="@dimen/vs_30"
                android:alpha="0.85"
                android:focusable="false"
                android:src="@drawable/icon_search" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnCollect"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_10"
            android:background="@drawable/shape_user_focus"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/vs_30"
                android:layout_height="@dimen/vs_30"
                android:alpha="0.85"
                android:focusable="false"
                android:src="@drawable/icon_collect" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSetting"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_10"
            android:background="@drawable/shape_user_focus"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/vs_30"
                android:layout_height="@dimen/vs_30"
                android:alpha="0.85"
                android:focusable="false"
                android:src="@drawable/icon_setting" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnPush"
            android:layout_width="@dimen/vs_60"
            android:layout_height="@dimen/vs_60"
            android:layout_marginLeft="@dimen/vs_10"
            android:background="@drawable/shape_user_focus"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/vs_30"
                android:layout_height="@dimen/vs_30"
                android:alpha="0.85"
                android:focusable="false"
                android:src="@drawable/icon_push" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/vs_20"
            android:focusable="false"
            android:gravity="right|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:includeFontPadding="false"
                android:textColor="@color/color_FFFFFF"
                android:textSize="@dimen/ts_30"
                android:textStyle="bold"
                tools:text="13:36" />

            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/color_CCFFFFFF"
                android:textSize="@dimen/ts_16"
                tools:text="09月24日 周三" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/vs_30"
        android:layout_marginTop="@dimen/vs_5"
        android:layout_marginRight="@dimen/vs_30"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topLayout">

        <com.github.tvbox.osc.ui.tv.widget.NoScrollViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
