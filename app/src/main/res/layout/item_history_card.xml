<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card_focus"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:padding="@dimen/vs_2">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="@dimen/vs_180"
            android:layout_height="@dimen/vs_240"
            android:focusable="false"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="@dimen/vs_180"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_8"
            android:ellipsize="end"
            android:focusable="false"
            android:singleLine="true"
            android:textColor="@color/color_FFFFFF"
            android:textSize="@dimen/ts_22" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="@dimen/vs_180"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/vs_2"
            android:layout_marginBottom="@dimen/vs_5"
            android:ellipsize="end"
            android:focusable="false"
            android:singleLine="true"
            android:textColor="@color/newui_text_secondary"
            android:textSize="@dimen/ts_18" />
    </LinearLayout>
</FrameLayout>
